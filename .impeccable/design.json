      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:2.6rem;padding:.3rem 1.25rem .35rem;font-family:'Cinzel',Georgia,serif;font-weight:700;font-variant:small-caps;font-size:.98rem;letter-spacing:.04em;color:#f1ece1;text-shadow:0 1px 2px #000;cursor:pointer;border:4px solid transparent;border-radius:2px;background:linear-gradient(rgba(70,72,64,.25),rgba(30,30,27,.35)) padding-box,linear-gradient(180deg,#4a4843,#3a3834) padding-box,linear-gradient(180deg,#8d8a84 0%,#5d5a54 18%,#4a4843 50%,#3a3834 82%,#5f5c56 100%) border-box;box-shadow:inset 0 0 0 1px #0d0c0a,inset 0 0 0 2px rgba(119,115,106,.8),0 0 0 1px #111,0 3px 6px rgba(0,0,0,.55);transition:filter .12s}.ds-btn:hover{filter:brightness(1.18);color:#fff}.ds-btn:active{filter:brightness(.92)}.ds-btn:focus-visible{outline:2px solid #e0b872;outline-offset:2px}"
